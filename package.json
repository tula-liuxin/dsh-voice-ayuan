{
  "name": "voice-ayuan",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "description": "阿源语音通话：豆包式实时语音（DeepSeek V4.1 Flash 前台 + speech-to-speech 本地管线），任务真正接入当前 DSH 会话执行。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/**",
    "bridge/**",
    "prompt/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check index.js && node build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "qwen-audio-agent": "^2.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ws": "8.22.0"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  }
}
