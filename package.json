{
  "name": "@local/voice-ayuan",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "阿源语音通话：在 DSH 输入区点一个图标，和本地 speech-to-speech 实时对话，并把活派给阿源。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "qwen-audio-agent": "^2.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}